{
  "$schema": "../../../../../git/gotgenes/pi-packages/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": true,
  "permissionReviewLog": true,
  "yoloMode": false,
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".git/objects/*": "deny",
      ".git/logs/*": "deny",
      "/TODO.nix/*": "allow",
      "/tmp/*": {
        "action": "deny",
        "reason": "create and use your own, private `./tmp_ABC456/` in the cwd."
      },
      "~/.ssh/*": "deny"
    },
    "read": {
      "*": "allow",
      "/below-here-is-not-yet-confirmed": "deny"
    },
    "write": {
      "*": "ask",
      ".git/*": "deny",
      "*.lock": "deny",
      "/nix/*": "deny"
    },
    "bash": {
      "*": "allow",

      "rm *": "ask",
      "rm -rf *": "deny",
      "rmdir *": "ask",
      "unlink *": "ask",
      "find * -delete *": "ask",

      "git *": "ask",
      "git blame *": "allow",
      "git branch": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git ls-tree *": "allow",
      "git remote -v": "allow",
      "git show *": "allow",
      "git status *": "allow",

      "truncate *": "ask",
      "dd *": "ask",

      "mkfs*": "deny",
      "newfs_*": "deny",
      "wipefs *": "deny",
      "diskutil *": "deny",
      "diskutil * eraseDisk *": "deny",
      "diskutil * eraseVolume *": "deny",
      "hdiutil *": "ask",
      "gpt *": "deny",
      "asr *": "deny",
      "parted *": "deny",
      "fdisk *": "deny",
      "gdisk *": "deny",
      "sgdisk *": "deny",
      "cryptsetup *": "deny",
      "pvcreate *": "deny",
      "vgcreate *": "deny",
      "lvcreate *": "deny",
      "zpool *": "deny",

      "chmod * -R *": "ask",
      "chmod * --recursive *": "ask",
      "chown * -R *": "ask",
      "chown * --recursive *": "ask",

      "mv * -f *": "ask",
      "mv * --force *": "ask",
      "cp * -f *": "ask",
      "cp * --force *": "ask",

      "sed -i *": "ask",
      "sed --in-place *": "ask",
      "perl -i *": "ask",
      "perl -pi *": "ask",

      "kill *": "ask",
      "kill * -9 *": "deny",
      "pkill *": "ask",
      "killall *": "ask",

      "halt *": "deny",
      "poweroff *": "deny",
      "reboot *": "deny",
      "shutdown *": "deny",
      "systemctl *": "ask",

      "curl * | *": "deny",
      "wget * | *": "deny",

      "kubectl delete *": "deny",
      "terraform destroy *": "deny",
      "aws s3 rm * --recursive *": "deny",
      "gcloud * delete *": "deny",

      "xdg-open 'http://127.0.0.1:*/*'": "allow",
      "xdg-open 'http://localhost:*/*'": "allow",
      "xdg-open 'https://github.com/*'": "allow"
    },
    "external_directory": {
      "*": "deny",
      "/home/deck/git/amosblomqvist/pi-subagents/agents/*": "allow",
      "/home/deck/git/benithors/skills/skills/*": "allow",
      "/home/deck/git/mattpocock/skills/skills/*": "allow",
      "/home/deck/git/tmustier/pi-extensions/extending-pi/*": "allow",
      "/nix/*": "allow",
      "/tmp": {
        "action": "deny",
        "reason": "create and use your own, private `./tmp_ABC456/` in the cwd."
      },
      "/below-here-is-not-yet-confirmed": "deny"
    }
  }
}
