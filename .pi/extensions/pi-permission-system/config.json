{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permission": {
    "path": {
      "*": "allow",
      "auth.json": "deny",
      "sessions/*": "deny"
    },
    "write": {
      "*": "allow",
      ".pi/*": "ask",
      "git/*": "deny",
      "npm/*": "deny",
      "sessions/*": "deny"
    }
  },
  "piInfrastructureReadPaths": [
    "~/git/amosblomqvist/pi-config/",
    "~/git/badlogic/pi-skills/",
    "~/git/benithors/skills/",
    "~/git/earendil-works/pi-mono/",
    "~/git/mattpocock/skills/",
    "~/git/tmustier/pi-extensions/"
  ]
}
