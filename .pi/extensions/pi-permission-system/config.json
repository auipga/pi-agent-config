{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permission": {
    "path": {
      "*": "allow",
      "auth.json": "deny",
      "sessions/*": "deny"
    },
    "write": {
      "*": "allow",
      ".pi/*": "ask",
      "git/*": "deny",
      "npm/*": "deny",
      "sessions/*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/git/amosblomqvist/pi-config/*": "allow",
      "~/git/badlogic/pi-skills/*": "allow",
      "~/git/benithors/skills/*": "allow",
      "~/git/earendil-works/pi-mono/*": "allow",
      "~/git/mattpocock/skills/*": "allow",
      "~/git/tmustier/pi-extensions/*": "allow"
    }
  }
}
