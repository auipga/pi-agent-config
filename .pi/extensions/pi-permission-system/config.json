{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-permission-system/main/schemas/permissions.schema.json",
  "permission": {
    "path": {
      "*": "allow",
      "auth.json": "deny",
      "sessions/*": "deny"
    },
    "write": {
      "*": "allow",
      ".pi/*": "ask",
      ".pi/extensions/pi-permission-system/config.json": "allow",
      "git/*"     : { "action": "deny", "reason": "Pi installs packages in this folder. Changes here would not be persistent." },
      "npm/*"     : { "action": "deny", "reason": "Pi installs packages in this folder. Changes here would not be persistent." },
      "sessions/*": { "action": "deny", "reason": "Pi sessions must not be altered by an LLM but by the harness." }
    },
    "external_directory": {
      "*": "deny",
      "/home/deck/git": "ask",
      "/home/deck/git/amosblomqvist/pi-config": "allow",
      "/home/deck/git/badlogic/pi-skills": "allow",
      "/home/deck/git/earendil-works/pi-mono": "allow",
      "/home/deck/git/gotgenes/pi-packages": "allow",
      "/home/deck/git/tmustier/pi-extensions": "allow",
      "/below-here-is-not-yet-confirmed": "deny"
    }
  }
}
