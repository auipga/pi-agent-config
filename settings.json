{
  "lastChangelogVersion": "0.74.0",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.4",
  "defaultThinkingLevel": "off",
  "hideThinkingBlock": false,
  "showHardwareCursor": false,
  "followUpMode": "all",
  "transport": "sse",
  "quietStartup": false,
  "doubleEscapeAction": "tree",
