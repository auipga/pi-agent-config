{
  "lastChangelogVersion": "0.73.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-4-6",
  "defaultThinkingLevel": "off",
  "hideThinkingBlock": true,
  "showHardwareCursor": false,
  "followUpMode": "all",
  "transport": "sse",
  "quietStartup": false,
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "theme": "dark",
  "enabledModels": [
    "anthropic/claude-haiku-4-5",
    "anthropic/claude-sonnet-4-6",
    "anthropic/claude-opus-4-7",
    "openai-codex/gpt-5.5"
  ],
  "autocompleteMaxVisible": 20,
  "steeringMode": "one-at-a-time",
  "packages": [
    {
      "source": "git:github.com/MasuRii/pi-rtk-optimizer",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "git:github.com/dheerapat/pi-token-stats",
      "extensions": [
        "+index.ts"
      ]
    },
    {
      "source": "git:github.com/badlogic/pi-telegram",
      "extensions": [
        "-index.ts"
      ]
    },
    {
      "source": "git:github.com/nicobailon/pi-subagents",
      "extensions": [
        "-src/extension/index.ts"
      ],
      "prompts": [
        "-prompts/gather-context-and-clarify.md",
        "-prompts/parallel-cleanup.md",
        "-prompts/parallel-context-build.md",
        "-prompts/parallel-handoff-plan.md",
        "-prompts/parallel-research.md",
        "-prompts/parallel-review.md"
      ],
      "skills": [
        "-skills/pi-subagents/SKILL.md"
      ]
    }
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "enableSkillCommands": true,
  "collapseChangelog": true,
  "skills": [
    "-skills/amosblomqvist/orchestrator/SKILL.md",
    "-skills/amosblomqvist/pdf-reader/SKILL.md",
    "-skills/amosblomqvist/reddit/SKILL.md",
    "-skills/amosblomqvist/stop-slop/SKILL.md",
    "-skills/badlogic/pi-skills/brave-search/SKILL.md",
    "-skills/badlogic/pi-skills/browser-tools/SKILL.md",
    "-skills/badlogic/pi-skills/gccli/SKILL.md",
    "-skills/badlogic/pi-skills/gdcli/SKILL.md",
    "-skills/badlogic/pi-skills/gmcli/SKILL.md",
    "-skills/badlogic/pi-skills/transcribe/SKILL.md",
    "-skills/badlogic/pi-skills/vscode/SKILL.md",
    "-skills/badlogic/pi-skills/youtube-transcript/SKILL.md"
  ],
  "extensions": [
    "-extensions/gnome-system-theme.ts"
  ]
}